{
  "info": {
    "name": "Mediva API - Fase 1",
    "description": "API Collection untuk testing Mediva Backend - Fase 1: Fondasi API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public Endpoints",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Mengecek status kesehatan API dan koneksi database. Endpoint ini tidak memerlukan authentication."
          },
          "response": []
        },
        {
          "name": "Register (Pembeli)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Jika register berhasil, simpan token",
                  "if (jsonData.status === \"success\" && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Token saved:\", jsonData.data.token);",
                  "}",
                  "",
                  "// Test response",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has token\", function () {",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser1\",\n  \"no_hp\": \"081234567890\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"jenis_kelamin\": \"L\",\n  \"tanggal_lahir\": \"1995-05-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            },
            "description": "Mendaftarkan user baru dengan role pembeli. Token otomatis disimpan ke environment variable setelah register berhasil."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Jika login berhasil, simpan token",
                  "if (jsonData.status === \"success\" && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Token saved:\", jsonData.data.token);",
                  "}",
                  "",
                  "// Test response",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has token\", function () {",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"testuser1\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Login untuk semua role. login_id bisa berupa username atau no_hp. Token otomatis disimpan ke environment variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Protected Endpoints",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            },
            "description": "Mendapatkan informasi user yang sedang login. Memerlukan Bearer token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            },
            "description": "Logout dari device saat ini. Token akan dihapus dari database."
          },
          "response": []
        },
        {
          "name": "Get Obat Count (Admin Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/obat/count",
              "host": ["{{base_url}}"],
              "path": ["obat", "count"]
            },
            "description": "Testing endpoint untuk middleware role. Hanya admin yang bisa akses. Akan return 403 jika role bukan admin."
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    }
  ]
}
